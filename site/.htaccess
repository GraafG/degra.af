RewriteEngine On

# Only redirect www to non-www (let the server handle HTTPS)
#
# The trailing $ is load-bearing. Without it the pattern is an unanchored
# prefix match, so any Host merely BEGINNING with www.degra.af matches --
# including www.degra.af.evil.example, which would be answered with a 301.
# Measured on httpd 2.4, AllowOverride All:
#
#   Host                          unanchored    with (:[0-9]+)?$
#   www.degra.af                  301           301
#   www.degra.af:8443             301           301
#   degra.af                      200           200
#   www.degra.af.evil.example     301  <- bug   200
#
# Note the :8443 row is identical in both columns: the unanchored form
# passes a port probe for the same reason it matches .evil.example. A gate
# asserting only "a :8443 Host redirects" is green on the broken config,
# which is why this survived. The (:[0-9]+)? group is what handles the
# port deliberately; the $ is what stops everything else.
RewriteCond %{HTTP_HOST} ^www\.degra\.af(:[0-9]+)?$ [NC]
RewriteRule ^(.*)$ https://degra.af/$1 [R=301,L]

# Security headers
#
# HSTS: the `preload` directive is deliberately OMITTED. Do not re-add it.
#
# Removing `preload` is NOT a security downgrade. max-age=31536000 and
# includeSubDomains are unchanged, so every browser still enforces HTTPS for
# this domain and all subdomains for a full year after any visit. The only
# thing `preload` adds is *consent to be submitted* to the Chrome HSTS preload
# list, which ships baked into browsers.
#
# That consent is not ours to leave lying around. Submission is not restricted
# to the domain owner: anyone may submit a domain whose header advertises
# `preload`, and hstspreload.org accepts it if the site is otherwise eligible.
# This site is otherwise eligible (2026-08-04: the preloadable API returned
# zero errors and zero warnings), so keeping the token is a standing, open
# invitation for a stranger to commit us to something we never decided.
#
# The commitment is effectively irreversible and covers subdomains we have not
# created yet. Preload + includeSubDomains means every present and future
# subdomain MUST serve valid HTTPS in browsers shipping the list, with no way
# to exempt one and no fast off switch. A staging host, a mail interface, or a
# third-party tool on a CNAME that later needs plain HTTP becomes unreachable,
# not merely insecure.
#
# We have already paid this bill once. The sibling domain geertdegraaf.nl,
# owned by the same person, was preloaded and then had to be taken off:
#
#   $ curl -s "https://hstspreload.org/api/v2/status?domain=geertdegraaf.nl"
#   { "name": "geertdegraaf.nl", "status": "removed", ... }
#
#   $ curl -s "https://hstspreload.org/api/v2/preloadable?domain=geertdegraaf.nl"
#   { "errors": [ { "code": "header.preloadable.preload.missing", ... } ] }
#
# Removal is slow and has to wait for browser releases to roll over. That
# domain now keeps itself off the list purely by omitting this one token, and
# the API confirms the missing token is the only thing doing it.
#
# A CI gate in .github/workflows/pr-open.yml asserts this line keeps max-age,
# keeps includeSubDomains, and stays free of `preload`.
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
Header set Content-Security-Policy "default-src 'self'; img-src 'self' https: data:; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; connect-src 'self';"
Header set X-Content-Type-Options "nosniff"
Header set X-Frame-Options "SAMEORIGIN"
Header set X-XSS-Protection "1; mode=block"

# RFC 9116 section 3 requires security.txt to be served as
# "text/plain; charset=utf-8". Apache's mime.types maps .txt to a bare
# text/plain with no charset, so the charset has to be set explicitly.
#
# Not a live defect today: the file is 231 bytes of pure ASCII (highest byte
# value 121), which decodes identically under UTF-8 and under any charset a
# client would otherwise assume. This closes a conformance gap and makes the
# encoding explicit before a future non-ASCII byte -- an accented name in a
# Contact line, say -- starts depending on the client's guess.
#
# Double quotes match every other quoted argument in this file. A single-quoted
# argument was measured against Apache 2.4.68 and also works, so this is
# consistency rather than correctness -- and the CI gate deliberately does not
# assert quote style, since a gate that goes red on a working configuration is
# worse than no gate.
#
# <Files> matches on basename in this directory and below, which is what
# reaches .well-known/security.txt from the docroot .htaccess.
<Files "security.txt">
  ForceType "text/plain; charset=utf-8"
</Files>

# Deny access to dotfiles and directories (except .well-known)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule (?:^|/)(\.|\.git|\.github) - [R=404,L]
</IfModule>